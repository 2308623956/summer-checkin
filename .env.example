# Summer Checkin 环境变量样例。**这是模板，不是能被自动加载的文件。**
#
# 本机热重载时两个服务都不读根目录的 .env：
#   - service 读 service/.env；web 读 web/.env.local（Next.js 只认自己目录下的 .env*）
#   - 生产 compose 读根目录 .env（infra/docker-compose.yml 的 env_file）
# 所以本地要把下面两段拆成两份；详见根 README「环境变量怎么分」。
#
# R000 阶段只有前三项是必需的（缺了服务会拒绝启动）。带 (R0xx) 的等到对应需求再填。

# ---------------------------------------------------------------- service
# PostgreSQL 连接串。R000 阶段不填真值：迁移用离线渲染验证
# （`uv run alembic upgrade head --sql`），只有真正起服务时才需要连库。
# 库由 infra/db/init-databases.sh 在 db 容器首次初始化时建出。
# 本地开发连测试库——**库名必须以 _test 结尾**，downgrade 有护栏。
SUMMER_DATABASE_URL=postgresql+asyncpg://summer:CHANGE_ME@127.0.0.1:5432/summer_checkin_test

# 校验 web 签发的 JWT（RS256 公钥，PEM 单行、\n 转义）。与 web 侧配对。
SUMMER_JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nCHANGE_ME\n-----END PUBLIC KEY-----

# POST /api/v1/cron/daily 的 Bearer；生成：openssl rand -hex 32
SUMMER_CRON_SECRET=CHANGE_ME

# --- 以下为可选，缺省值见 docs/tech/integrations.md §5.1 ---
# 环境名：/meta 会返回它，便于确认实例连的是哪个环境。
SUMMER_ENV=development
SUMMER_LOG_LEVEL=info
SUMMER_TZ=Asia/Shanghai
SUMMER_SCHEDULE_CRON=0 21 * * *
SUMMER_AI_TOKEN_LIMIT=100000
SUMMER_AGENT_DAILY_TOKENS=20000
SUMMER_DAILY_BUDGET_USD=3
# 开发期自动迁移：启动时先 upgrade head 再 alembic check。生产必须为 false。
SUMMER_AUTO_MIGRATE=true

# --- 模型池（R002 起需要；R000 用假 client 单测，可不填）---
SUMMER_AGNES_API_KEY=
SUMMER_AGNES_BASE_URL=https://api.agnes-ai.cn/v1
SUMMER_ALIYUN_API_KEY=
SUMMER_EMBEDDING_API_KEY=

# --- 对象存储（R006 起需要）---
SUMMER_OSS_ACCESS_KEY_ID=
SUMMER_OSS_ACCESS_KEY_SECRET=
SUMMER_OSS_BUCKET=summer-checkin-app
SUMMER_OSS_REGION=oss-cn-guangzhou
SUMMER_OSS_PUBLIC_BASE_URL=

# ---------------------------------------------------------------- web
# Better Auth 自身用的库（与 service 同库，各管各的表）。
DATABASE_URL=postgresql://summer:CHANGE_ME@127.0.0.1:5432/summer_checkin_test
BETTER_AUTH_SECRET=CHANGE_ME
BETTER_AUTH_URL=http://localhost:3000

# 私钥只给 web：service 只拿公钥，签不了 token（见任务 design.md D2）。
SUMMER_JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nCHANGE_ME\n-----END PRIVATE KEY-----
# 仅本地开发 rewrite 用；线上经 nginx 同域，不需要它。
SUMMER_SERVICE_URL=http://127.0.0.1:8000

# --- 对象存储（R006 起需要，与 service 同值）---
SUMMER_OSS_ACCESS_KEY_ID=
SUMMER_OSS_ACCESS_KEY_SECRET=
SUMMER_OSS_BUCKET=summer-checkin-app
SUMMER_OSS_REGION=oss-cn-guangzhou
SUMMER_OSS_PUBLIC_BASE_URL=
