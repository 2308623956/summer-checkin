# ============================================================
# Summer Checkin 环境变量配置
# ============================================================
#
# 本地开发：cp .env.example .env.local
# Docker/服务器：cp .env.example .env
#
# service 和 web 都从仓库根读取（代码里锚定了根目录）

# --- 端口配置 ---
HTTP_PORT=80
WEB_PORT=3000
SERVICE_PORT=8000
POSTGRES_PORT=5432

# --- 数据库配置 ---
POSTGRES_USER=summer
POSTGRES_PASSWORD=summer_checkin_dev
POSTGRES_DB=summer_checkin

# 数据库连接地址（标准 PostgreSQL URL）
# 本地开发：host 改成 localhost
# Docker/服务器：host 改成 db
DATABASE_URL=postgresql://summer:summer_checkin_dev@localhost:5432/summer_checkin

# --- JWT 配置 ---
# 对称密钥，web 签发、service 验签（HS256）
# 生成：openssl rand -base64 32
JWT_SECRET=CHANGE_ME_RANDOM_BASE64_STRING_MIN_32_CHARS

# --- Service 配置 ---
# POST /api/v1/cron/daily 的 Bearer token
# 生成：openssl rand -hex 32
SUMMER_CRON_SECRET=CHANGE_ME_RANDOM_HEX_STRING

# 环境名（development / production）
SUMMER_ENV=development

# 开发期启动时自动运行数据库迁移；生产环境必须改成 false
SUMMER_AUTO_MIGRATE=true

# 以下配置有默认值，通常不需要填写
# SUMMER_LOG_LEVEL=info
# SUMMER_TZ=Asia/Shanghai
# SUMMER_SCHEDULE_CRON=0 21 * * *
# SUMMER_AI_TOKEN_LIMIT=100000
# SUMMER_AGENT_DAILY_TOKENS=20000
# SUMMER_DAILY_BUDGET_USD=3

# --- Web 配置 ---
# Better Auth 密钥
# 生成：openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_RANDOM_BASE64_STRING

# Better Auth 回调地址
# 本地：http://localhost:3000
# 服务器：公网域名（不带端口）
BETTER_AUTH_URL=http://localhost:3000

# 浏览器侧 Better Auth 客户端的 baseURL（不填则用当前源）
# NEXT_PUBLIC_BETTER_AUTH_URL=

# 本地开发 rewrite 用（next.config.ts 转发 /api/v1/* 到这个地址）
# 注意：这个值在 next build 时写入 .next/routes-manifest.json，运行期改无效
SUMMER_SERVICE_URL=http://127.0.0.1:8000

# --- 对象存储（暂时不需要）---
# SUMMER_OSS_ACCESS_KEY_ID=
# SUMMER_OSS_ACCESS_KEY_SECRET=
# SUMMER_OSS_BUCKET=summer-checkin-app
# SUMMER_OSS_REGION=oss-cn-guangzhou
# SUMMER_OSS_PUBLIC_BASE_URL=

# --- AI 模型池（暂时不需要）---
# SUMMER_AGNES_API_KEY=
# SUMMER_AGNES_BASE_URL=https://api.agnes-ai.cn/v1
# SUMMER_ALIYUN_API_KEY=
# SUMMER_EMBEDDING_API_KEY=