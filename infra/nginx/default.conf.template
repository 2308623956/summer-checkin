# 路径分流：`/` 与 `/api/auth/*` → web，`/api/v1/*` → service。
# 浏览器只认识一个域名，不需要知道后面有两个后端（architecture.md §6）。
# 端口从环境变量读取，nginx 官方镜像会自动用 envsubst 替换 ${VAR}

upstream summer_web {
    server web:${WEB_PORT};
    keepalive 16;
}

upstream summer_service {
    server service:${SERVICE_PORT};
    keepalive 16;
}

server {
    listen ${HTTP_PORT};
    server_name _;

    # 上传打卡截图会用到，默认 1m 太小。
    client_max_body_size 12m;

    # 透传请求 id：没有就生成一个，响应与日志都带着它（architecture.md §7.4）。
    map $http_x_request_id $summer_request_id {
        default   $http_x_request_id;
        ""        $request_id;
    }

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-Id      $summer_request_id;
    proxy_http_version 1.1;
    proxy_set_header Connection "";

    # 业务接口：直连 service。
    # 这个 location 必须排在 "/" 前面，否则会被 web 吃掉（表现为线上 404）。
    location /api/v1/ {
        proxy_pass http://summer_service;

        # 巡检与复盘可能跑较久，但同样不该无限等。
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;

        # SSE（复盘作答）不能被缓冲，否则前端一个字都收不到。
        proxy_buffering off;
        proxy_cache off;
    }

    # 认证：Better Auth 写在 web 里。
    location /api/auth/ {
        proxy_pass http://summer_web;
    }

    # 页面与静态资源。
    location / {
        proxy_pass http://summer_web;
    }
}
